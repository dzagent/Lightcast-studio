{
  "name": "lightcast-studio",
  "productName": "LightCast Studio",
  "version": "0.1.0",
  "description": "Lightweight open-source live production studio with Undo/Redo",
  "author": "LightCast",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV=1 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "org.lightcast.studio",
    "productName": "LightCast Studio",
    "directories": { "output": "release" },
    "files": ["dist/**", "electron/**", "package.json"],
    "asarUnpack": ["node_modules/ffmpeg-static/**"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": {
      "target": [{ "target": "dmg" }],
      "category": "public.app-category.video",
      "extendInfo": {
        "NSCameraUsageDescription": "LightCast Studio needs the camera to use it as a video source.",
        "NSMicrophoneUsageDescription": "LightCast Studio needs the microphone for audio sources."
      }
    },
    "publish": null
  }
}
